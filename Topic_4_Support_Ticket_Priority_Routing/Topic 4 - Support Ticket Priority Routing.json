      "id": "node-1-webhook-ticket-intake",
      "name": "Webhook_TicketIntake",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\n\nconst name = String(body.customerName || '').trim();\nconst email = String(body.customerEmail || '').trim().toLowerCase();\nconst subject = String(body.subject || '').trim();\nconst description = String(body.description || '').trim();\nconst rawPriority = String(body.priority || '').trim();\n\n// Check presence of mandatory fields\nconst missing = [];\nif (!name) missing.push(\"customerName\");\nif (!email) missing.push(\"customerEmail\");\nif (!subject) missing.push(\"subject\");\nif (!rawPriority) missing.push(\"priority\");\n\nconst isValid = missing.length === 0;\n\n// Normalize priority to Title Case (e.g. 'urgent' -> 'Urgent')\nlet normalizedPriority = \"Fallback\";\nif (rawPriority) {\n  normalizedPriority = rawPriority.charAt(0).toUpperCase() + rawPriority.slice(1).toLowerCase();\n}\n\nreturn {\n  json: {\n    isValid: isValid,\n    missingFields: missing,\n    ticket: {\n      customerName: name,\n      customerEmail: email,\n      subject: subject,\n      description: description,\n      priority: normalizedPriority,\n      rawPriority: rawPriority,\n      submittedAt: new Date().toISOString()\n    }\n  }\n};"
      },
      "id": "node-2-validate-and-sanitize",
      "name": "Code_ValidateAndSanitize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond-has-required-fields",
              "leftValue": "={{ $json.isValid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-3-if-has-required-fields",
      "name": "IF_HasRequiredFields",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
