        "jsCode": "return [\n  { json: { customerId: 'CUST-1001', companyName: 'Apex Logistics LLC', segment: 'Enterprise' } },\n  { json: { customerId: 'CUST-1002', companyName: 'Nexus BioTech', segment: 'Mid-Market' } }\n];"
