      "id": "node-merge-pdf",
      "name": "Merge_With_PDFExpenses",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [
        1140,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst rev = Number(item.totalSpendUSD || 0);\nconst exp = Number(item.pdfExpenseUSD || 0);\nconst netMargin = Number((rev - exp).toFixed(2));\n\nreturn {\n  json: {\n    customerId: item.customerId,\n    companyName: item.companyName,\n    segment: item.segment,\n    totalSpendUSD: rev,\n    pdfExpenseUSD: exp,\n    netMarginUSD: netMargin,\n    tier: rev >= 100000 ? 'Enterprise Tier 1' : 'Standard',\n    synchronizedAt: new Date().toISOString()\n  }\n};"
      },
      "id": "node-customer-360",
      "name": "Transform_ComputeCustomer360",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
