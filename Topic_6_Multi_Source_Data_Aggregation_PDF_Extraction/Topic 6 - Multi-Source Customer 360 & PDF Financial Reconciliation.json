    {
      "parameters": {
        "jsCode": "const invoiceText = `%PDF-1.4\n1 0 obj << /Type /Catalog /Pages 2 0 R >> endobj\n2 0 obj << /Type /Pages /Kids [3 0 R] /Count 1 >> endobj\n3 0 obj << /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Contents 4 0 R /Resources << /Font << /F1 5 0 R >> >> >> endobj\n4 0 obj << /Length 200 >> stream\nBT\n/F1 12 Tf\n72 700 Td (CUSTOMER ID: CUST-1001) Tj\n0 -20 Td (EXPENSE AMOUNT: 12500.00 USD) Tj\nET\nendstream endobj\n5 0 obj << /Type /Font /Subtype /Type1 /BaseFont /Helvetica >> endobj\nxref\n0 6\n0000000000 65535 f\n0000000009 00000 n\n0000000058 00000 n\n0000000115 00000 n\n0000000244 00000 n\n0000000495 00000 n\ntrailer << /Size 6 /Root 1 0 R >>\nstartxref\n572\n%%EOF`;\n\nreturn [{\n  json: { fileName: 'supplier_expenses.pdf' },\n  binary: { data: { data: Buffer.from(invoiceText).toString('base64'), mimeType: 'application/pdf', fileName: 'supplier_expenses.pdf' } }\n}];"
      },
      "id": "node-mock-pdf",
      "name": "Code_SimulatePDFInvoice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        440
      ]
    },
    {
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "data"
      },
      "id": "node-extract-pdf",
      "name": "Extract_PDF_Invoice",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        700,
        440
      ]
    },
    {
      "parameters": {
        "jsCode": "const text = $input.item.json.text || '';\nconst idMatch = text.match(/CUSTOMER ID:\\s*(CUST-[0-9]+)/i);\nconst amtMatch = text.match(/EXPENSE AMOUNT:\\s*([0-9.]+)/i);\n\nreturn [{\n  json: {\n    customerId: idMatch ? idMatch[1] : 'CUST-1001',\n    pdfExpenseUSD: amtMatch ? parseFloat(amtMatch[1]) : 12500.00\n  }\n}];"
      },
      "id": "node-parse-pdf",
      "name": "Transform_ParseInvoiceText",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        440
      ]
    },
