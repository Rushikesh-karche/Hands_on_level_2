    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nstaticData.processedTransactions = staticData.processedTransactions || [];\nconst body = $input.first().json.body || $input.first().json;\nconst transactionId = String(body.transactionId || '').trim();\nif (!transactionId) {\n  return {\n    json: {\n      isDuplicate: false,\n      hasId: false,\n      payload: body,\n      errorMsg: 'Missing required transactionId'\n    }\n  };\n}\nconst isDuplicate = staticData.processedTransactions.includes(transactionId);\nif (!isDuplicate) {\n  staticData.processedTransactions.push(transactionId);\n  if (staticData.processedTransactions.length > 500) {\n    staticData.processedTransactions.shift();\n  }\n}\nreturn {\n  json: {\n    transactionId: transactionId,\n    isDuplicate: isDuplicate,\n    hasId: true,\n    payload: body\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -592,
        368
      ],
      "id": "cbdf8d41-b39d-40f7-b0ef-30b40a8d27ce",
      "name": "Code_CheckIdempotency"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond-is-duplicate",
              "leftValue": "={{ $json.isDuplicate }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
