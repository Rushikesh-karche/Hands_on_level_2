        "path": "support-ticket",
        "responseMode": "onReceived",
        "options": {
          "responseCode": {
            "values": {
              "responseCode": "={{ 200 }}"
            }
          },
          "responseData": "{\n  \"status\": \"RECEIVED\",\n  \"message\": \"Ticket queued for routing\"\n}"
        }
